// Получение токена авторизации
async function getToken() {
    const url = `${config.BASE_URL}${config.AUTH_ROUTE}`;
    const authPayload = payloads.createAuthTokenPayload(config.CLIENT_ID, config.CLIENT_SECRET);
    const headers = payloads.setAuthHeaders();

    try {
        const response = await axios.post(url, authPayload, { headers });
        return response.data.access_token;
    } catch (error) {
        console.error(`Ошибка получения токена: ${error.message}`);
        throw error;
    }
}

// Ожидание завершения задачи с таймаутом
async function waitForJobCompletion(token, jobid, jobType) {
    const MAX_ATTEMPTS = 30; // Максимум попыток (5 минут при 10-секундных интервалах)
    let attempt = 0;

    while (attempt < MAX_ATTEMPTS) {
        try {
            const response = await getJobId(token, jobid);
            
            if (response.status === 'in-progress') {
                console.log(`Попытка ${attempt + 1}/${MAX_ATTEMPTS}: ${jobType} в процессе...`);
                await new Promise(resolve => setTimeout(resolve, 20000)); // 20 секунд
                attempt++;
                continue;
            }
            
            return response; // Задача завершена
        } catch (error) {
            console.error(`Ошибка проверки статуса задачи: ${error.message}`);
            throw error;
        }
    }

    throw new Error(`${jobType} превысил лимит ожидания (${MAX_ATTEMPTS} попыток)`);
}

// Получение данных задачи по ID
async function getJobId(token, jobId) {
    const url = `${config.BASE_URL}${config.GET_JOB_ROUTE}${jobId}`;
    const headers = payloads.setHeaders(token, config.USER_ID);

    try {
        const response = await axios.get(url, { headers });
        return response.data; // Возвращаем напрямую data
    } catch (error) {
        console.error(`Ошибка получения данных задачи: ${error.message}`);
        throw error;
    }
}

