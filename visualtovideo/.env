import requests
import logging
from flask import Flask, request, jsonify

# Настройка логирования
logging.basicConfig(
    level=logging.DEBUG,
    format='%(asctime)s - %(levelname)s - %(message)s'
)

# === Класс для работы с Pictory API ===
class PictoryAPI:
    BASE_URL = "https://api.pictory.ai"
    AUTH_ROUTE = "/pictoryapis/v1/oauth2/token"
    STORYBOARD_ROUTE = "/pictoryapis/v1/video/storyboard"
    RENDER_ROUTE = "/pictoryapis/v1/video/render"
    GET_JOB_ROUTE = "/pictoryapis/v1/jobs/"

    def __init__(self, client_id, client_secret, user_id):
        self.client_id = client_id
        self.client_secret = client_secret
        self.user_id = user_id
        self.access_token = None

    def get_access_token(self):
        """Получение токена доступа с обработкой ошибок"""
        url = self.BASE_URL + self.AUTH_ROUTE
        payload = {
            'client_id': self.client_id,
            'client_secret': self.client_secret,
            'grant_type': 'client_credentials'
        }

        try:
            response = requests.post(url, data=payload, timeout=10)
            response.raise_for_status()
            token_data = response.json()

            if 'access_token' not in token_data:
                raise ValueError("Отсутствует access_token в ответе")

            self.access_token = token_data['access_token']
            logging.info("Токен доступа успешно получен")
            return True
        except requests.exceptions.RequestException as err:
            logging.error(f"Ошибка сети: {str(err)}")
        except ValueError as ve:
            logging.error(f"Ошибка формата ответа: {ve}")
        except Exception as e:
            logging.error(f"Неизвестная ошибка: {str(e)}")

        self.access_token = None
        return False

    def _send_request(self, route, payload):
        """Общий метод для отправки запросов"""
        if not self.access_token and not self.get_access_token():
            return None

        url = self.BASE_URL + route
        headers = {
            'Authorization': f'Bearer {self.access_token}',
            'Content-Type': 'application/json'
        }

        try:
            response = requests.post(url, headers=headers, json=payload, timeout=15)
            response.raise_for_status()
            return response.json()
        except requests.exceptions.RequestException as err:
            logging.error(f"Ошибка запроса ({route}): {str(err)}")
        except Exception as e:
            logging.error(f"Ошибка обработки: {str(e)}")

        return None

    def create_storyboard(self, storyboard_data):
        full_data = {"userId": self.user_id, **storyboard_data}
        return self._send_request(self.STORYBOARD_ROUTE, full_data)

    def render_video(self, render_data):
        full_data = {"userId": self.user_id, **render_data}
        return self._send_request(self.RENDER_ROUTE, full_data)

    def get_job_status(self, job_id):
        if not self.access_token and not self.get_access_token():
            return None

        url = self.BASE_URL + self.GET_JOB_ROUTE + job_id
        headers = {'Authorization': f'Bearer {self.access_token}'}

        try:
            response = requests.get(url, headers=headers, timeout=10)
            response.raise_for_status()
            return response.json()
        except requests.exceptions.RequestException as err:
            logging.error(f"Ошибка получения статуса: {str(err)}")
        return None


# === Сервер для обработки вебхуков ===
app = Flask(__name__)

